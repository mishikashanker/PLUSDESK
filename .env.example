# No external services are contacted in demo mode.
MODE=demo
DATABASE_URL=sqlite:///./data/pulsedesk.db
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=demo-pulsedesk
SESSION_SECRET=
SECURE_COOKIES=false
TEAM_NAME=Orbit Studio
TEAM_TIMEZONE=Asia/Kolkata
SEED_DEMO=true
EMBEDDED_WORKER=true
DIGEST_HOUR=17
DIGEST_MINUTE=0
COLLECT_CHANNEL_MESSAGES=false
# Configure these when switching MODE=live. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_DISCLOSURE_CONFIRMED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PULSE
JIRA_ISSUE_TYPE=Task
TRACKER_AUDIENCE_CONFIRMED=false
SLACK_SIGNING_SECRET=demo-secret
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=TDEMO
SLACK_BOT_USER_ID=UDEMO
STANDUP_CHANNEL_ID=CDAILY
SLACK_WORKSPACE_DOMAIN=demo-team
PUBLISH_TO_SLACK=false
